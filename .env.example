# Banco de dados Postgres
DATABASE_URL=postgres://felpma:felpma@127.0.0.1:5432/felpma

# Segredo usado para assinar os logins do painel.
# Gere um valor longo e aleatório para produção, por exemplo: openssl rand -hex 32
PAYLOAD_SECRET=troque-este-valor

# Endereço público do site (usado no sitemap, no feed do calendário e nos links compartilhados)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Em produção (docker-compose.prod.yml) use o domínio canônico, sem www:
#   NEXT_PUBLIC_SERVER_URL=https://felpma.com.br
# POSTGRES_PASSWORD é lido do mesmo arquivo e precisa ser forte no servidor —
# o Postgres não fica acessível de fora (o overlay de produção remove o 5432).

# Opcional: credenciais do primeiro administrador criado pelo `pnpm seed`
# SEED_ADMIN_EMAIL=admin@felpma.org.br
# SEED_ADMIN_PASSWORD=

# --- Ndovu (observabilidade do frontend) -------------------------------------
# SDK no navegador. Os quatro são opcionais: faltar endpoint ou chave e o SDK
# fica no-op — o site continua funcionando igual, sem emitir nada.
#
# NEXT_PUBLIC_* é congelado no momento do BUILD (não do runtime). Trocar aqui
# exige `pnpm build` de novo; em produção é rebuild da imagem.
#
# A chave é de INGESTÃO apenas (gerada no backoffice do Ndovu em Apps → Cadastrar
# app). Ela é visível no bundle do navegador por natureza — nunca serve nada mais
# com ela, e ela nunca vale para outro app.
#
# Dev local:  http://localhost:18081
# Produção:   https://ndovu.suaempresa.com  (no .env da VPS + rebuild)
# NEXT_PUBLIC_NDOVU_ENDPOINT=http://localhost:18081
# NEXT_PUBLIC_NDOVU_API_KEY=ndk_...
#
# Precisa ser EXATAMENTE o "Nome" do app cadastrado no Ndovu — a ingestão responde
# 400 app_mismatch se divergir.
# NEXT_PUBLIC_NDOVU_APP=felpma
#
# Opcional: número da versão, para separar eventos por release no dashboard.
# NEXT_PUBLIC_APP_VERSION=1.0.0

# --- Backup (docker-compose.prod.yml) ----------------------------------------
# Roda 03:00 todo dia: pg_dump + tar.gz dos volumes de uploads.
# Sem os quatro R2_*, o backup fica só no disco da VPS.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=felpma-backups
#
# healthchecks.io — crie um check (período 24h, grace 2h) e cole o ping URL.
# HEALTHCHECK_URL=
# BACKUP_RETENTION_DAYS=14
# BACKUP_REMOTE_RETENTION_DAYS=30
