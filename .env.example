# Banco de dados Postgres
DATABASE_URL=postgres://felpma:felpma@127.0.0.1:5432/felpma

# Segredo usado para assinar os logins do painel.
# Gere um valor longo e aleatório para produção, por exemplo: openssl rand -hex 32
PAYLOAD_SECRET=troque-este-valor

# Endereço público do site (usado no sitemap, no feed do calendário e nos links compartilhados)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Opcional: credenciais do primeiro administrador criado pelo `pnpm seed`
# SEED_ADMIN_EMAIL=admin@felpma.org.br
# SEED_ADMIN_PASSWORD=
